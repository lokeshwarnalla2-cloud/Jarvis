class BootReceiver : BroadcastReceiver() {
    override fun onReceive(c: Context, i: Intent) {
        if (i.action == Intent.ACTION_BOOT_COMPLETED && c.getSharedPreferences("jarvis", 0).getBoolean("auto", false))
